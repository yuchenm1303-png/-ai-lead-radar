# Web / allowed origins
CORS_ORIGINS=https://smirel.com,http://localhost:3000

# Storage
DATABASE_PATH=./lead_radar.db

# AI provider. Keep rules for zero-cost/local mode; set openai only when a key + model are configured.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=

# Notifications
FEISHU_WEBHOOK_URL=
NOTIFY_MIN_SCORE=85

# Source-provider benchmark. Never commit real provider credentials.
TIKHUB_API_KEY=
RNOTE_API_KEY=
JUSTONE_API_TOKEN=
