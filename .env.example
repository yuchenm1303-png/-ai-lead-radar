# Web / allowed origins
CORS_ORIGINS=https://smirel.com,http://localhost:3000

# Storage
DATABASE_PATH=./lead_radar.db

# AI provider. Keep rules for zero-cost/local mode; set a model provider only when credentials are configured.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

# Lead Intelligence V3 semantic buyer-intent gate.
# Production enable/shadow/enforce mode and provider/model are controlled by lead_radar_intelligence_settings.
# Production credentials belong in Edge Function secrets or Supabase Vault, never in Git.
LEAD_SEMANTIC_MODEL=

# Notifications
FEISHU_WEBHOOK_URL=
NOTIFY_MIN_SCORE=85

# Just One Xiaohongshu V4 production collector.
# Keep the real token only in GitHub Actions secret JUSTONE_API_TOKEN.
JUSTONE_API_TOKEN=
JUSTONE_API_ENDPOINT=https://api.justoneapi.com/api/xiaohongshu/search-note/v4
JUSTONE_MAX_QUERIES_PER_RUN=1
JUSTONE_MAX_AGE_MINUTES=1440
LEAD_RADAR_API_BASE=https://nfzkphjbelyltrzgkdwt.supabase.co/functions/v1/lead-radar-collector

# Other source-provider benchmarks only. Never commit real provider credentials.
TIKHUB_API_KEY=
RNOTE_API_KEY=
